{
  "packages": [
    {
      "id": "bridge",
      "name": "VFS Provider Bridge",
      "enabled": true,
      "kind": "service",
      "runtime": "FastAPI / HTTP",
      "project_path": "%USERPROFILE%\\python_projects\\dms-provider-bridge",
      "base_url": "http://127.0.0.1:8765",
      "health_path": "/health",
      "config_path": "/config",
      "docs_path": "/docs",
      "order": 10
    },
    {
      "id": "broker",
      "name": "Credential Broker",
      "enabled": true,
      "kind": "service",
      "runtime": "HTTP service",
      "project_path": "%USERPROFILE%\\python_projects\\credential-broker",
      "base_url": "http://127.0.0.1:8776",
      "health_path": "/health",
      "order": 20
    },
    {
      "id": "mcp",
      "name": "VFS MCP Server",
      "enabled": true,
      "kind": "service",
      "runtime": "MCP over HTTP",
      "project_path": "%USERPROFILE%\\python_projects\\dms-mcp-server",
      "base_url": "http://127.0.0.1:8781",
      "health_path": "/health",
      "order": 30
    },
    {
      "id": "demi",
      "name": "Demi",
      "enabled": true,
      "kind": "application",
      "runtime": "FastAPI / Web UI",
      "project_path": "%USERPROFILE%\\python_projects\\dms-ai-client",
      "base_url": "http://127.0.0.1:8790",
      "health_path": "/health",
      "order": 40
    },
    {
      "id": "vfs-dms-chatgpt-plugin",
      "name": "VFS DMS for ChatGPT",
      "enabled": true,
      "kind": "plugin",
      "runtime": "OpenAI plugin / VFS MCP",
      "project_path": "%USERPROFILE%\\python_projects\\vfs-dms-chatgpt-plugin",
      "base_url": "http://127.0.0.1:8781/mcp",
      "static_status": "enabled",
      "mode": "read-only",
      "metadata": {
        "path": "%USERPROFILE%\\python_projects\\vfs-dms-chatgpt-plugin\\.codex-plugin\\plugin.json",
        "fields": {
          "version": "version"
        }
      },
      "details": [
        {"label": "Režim", "key": "mode"},
        {"label": "Závislost", "key": "depends_on"}
      ],
      "depends_on": ["mcp"],
      "order": 45
    },
    {
      "id": "secure-mcp-tunnel",
      "name": "Secure MCP Tunnel",
      "enabled": true,
      "kind": "gateway",
      "runtime": "OpenAI Secure MCP Tunnel",
      "project_path": "%USERPROFILE%\\python_projects\\vfs-dms-chatgpt-plugin\\tmp\\tunnel-client",
      "health_url_file": "%USERPROFILE%\\.local\\state\\tunnel-client\\health\\vfs-dms-local.url",
      "health_path": "/api/status",
      "profile": "%APPDATA%\\tunnel-client\\vfs-dms-local.yaml",
      "response_fields": {
        "version": "version",
        "started_at": "started_at",
        "tunnel_id": "control_plane_tunnel_id",
        "target_url": "mcp_server_url",
        "channel_status": "channels.0.probe_status"
      },
      "details": [
        {"label": "Tunnel", "key": "tunnel_id"},
        {"label": "Kanál", "key": "channel_status"},
        {"label": "Cíl", "key": "target_url"},
        {"label": "Profil", "key": "profile"}
      ],
      "depends_on": ["mcp"],
      "order": 46
    },
    {
      "id": "tc-wfx",
      "name": "TC-WFX",
      "enabled": true,
      "kind": "client",
      "runtime": "Total Commander WFX plugin",
      "version": "1.1.0",
      "process_names": ["TOTALCMD64", "TOTALCMD"],
      "installation": {
        "registry_file": "%APPDATA%\\GHISLER\\wincmd.ini",
        "registry_section": "FileSystemPlugins",
        "registry_key": "TC-VFS",
        "artifact_path": "%APPDATA%\\GHISLER\\Plugins\\wfx\\TcWfxPlugin\\TcWfxPlugin.wfx64",
        "module_name": "TcWfxPlugin.wfx64"
      },
      "project_path": "%USERPROFILE%\\python_projects\\tc-wfx-plugin",
      "order": 50
    },
    {
      "id": "logdy",
      "name": "VFS Debugger (Logdy)",
      "enabled": true,
      "kind": "debugger",
      "runtime": "VFS Logdy 0.18.1 / local web UI",
      "version": "0.18.1",
      "project_path": "%USERPROFILE%\\python_projects\\logdy-core",
      "base_url": "http://127.0.0.1:8801",
      "health_path": "/",
      "source": {
        "repository": "https://github.com/mergi72/logdy-core",
        "tag": "v0.18.1",
        "license": "Apache-2.0"
      },
      "launch": {
        "executable": "%USERPROFILE%\\python_projects\\logdy-core\\bin\\logdy-vfs.exe",
        "arguments": [
          "follow",
          "--full-read",
          "--config", "%USERPROFILE%\\python_projects\\vfs-platform-console\\config\\logdy.json",
          "--ui-ip", "127.0.0.1",
          "--port", "8801",
          "--no-analytics",
          "--no-updates",
          "--max-message-count", "10000"
        ],
        "log_sources": [
          {
            "alternatives": [
              "%APPDATA%\\DMS Provider\\logs\\bridge-debug.log",
              "%APPDATA%\\DMS Provider\\logs\\bridge.log",
              "%USERPROFILE%\\python_projects\\dms-provider-bridge\\tmp\\bridge.stdout.log"
            ]
          },
          {
            "alternatives": [
              "%APPDATA%\\Credential Broker\\logs\\broker-debug.log",
              "%APPDATA%\\Credential Broker\\logs\\broker.log"
            ]
          },
          {
            "alternatives": [
              "%APPDATA%\\DMS MCP\\logs\\mcp-debug.log",
              "%APPDATA%\\DMS MCP\\logs\\mcp.log"
            ]
          },
          {
            "alternatives": [
              "%APPDATA%\\DMS AI Client\\logs\\demi-debug.log",
              "%APPDATA%\\DMS AI Client\\logs\\demi.log"
            ]
          },
          "%APPDATA%\\GHISLER\\Plugins\\wfx\\TcWfxPlugin\\logs\\wfx-init.log",
          "%APPDATA%\\GHISLER\\Plugins\\wfx\\TcWfxPlugin\\logs\\wfx-default-params.log",
          "%APPDATA%\\GHISLER\\Plugins\\wfx\\TcWfxPlugin\\logs\\wfx-status.log",
          "%APPDATA%\\GHISLER\\Plugins\\wfx\\TcWfxPlugin\\logs\\progress-debug.log"
        ]
      },
      "order": 1
    }
  ]
}
